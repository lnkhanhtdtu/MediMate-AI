# Supabase Connection Keys
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Required for the Admin Portal (stats, patient directory, user CRUD, broadcast).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: override the Gemini model in one place (verify it exists in your account).
# Default is gemini-3.1-flash-lite.
# GEMINI_MODEL=gemini-3.1-flash-lite

# Admin allowlist — comma-separated emails granted Admin Portal access (server-side, not spoofable).
ADMIN_EMAILS=admin@medimate.ai
